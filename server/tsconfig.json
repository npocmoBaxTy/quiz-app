{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    // File Layout: server.ts -> dist/server.js, src/** -> dist/src/**
    "rootDir": "./",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    
    "target": "es2020",
    "lib": ["ESNext"],
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    // Приложение, а не библиотека — .d.ts никто не потребляет, только замедляют сборку
    "declaration": false,
    "declarationMap": false,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  // prisma.config.ts нужен только CLI и в рантайм-сборку не попадает
  "include": ["server.ts", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
