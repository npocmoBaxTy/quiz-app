# Скопируйте в server/.env и заполните. Сервер падает на старте,
# если не заданы DATABASE_URL, JWT_SECRET или REFRESH_SECRET.

# --- База данных ---
# Пулер (порт 6543 у Supabase) — его использует приложение
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Прямое подключение (порт 5432) — нужно только Prisma CLI для миграций
DIRECT_URL="postgresql://user:password@host:5432/postgres"
# false — для локального postgres без SSL (например в docker-compose)
DATABASE_SSL=true

# --- Приложение ---
PORT=5000
NODE_ENV=production
# Домены фронтенда через запятую
CORS_ORIGIN=https://example.com,http://localhost:5173
# Число прокси между клиентом и приложением. За nginx/Render/Railway = 1,
# без прокси = false. Влияет на корректность rate-limit по IP.
TRUST_PROXY=1
# Каталог с загруженными изображениями (относительно рабочей директории)
UPLOADS_DIR=uploads

# --- Секреты (сгенерируйте: openssl rand -base64 48) ---
JWT_SECRET=
REFRESH_SECRET=

# --- Необязательное ---
# Без ключа роут AI-генерации вопросов вернёт 500 с понятным сообщением
GEMINI_API_KEY=
